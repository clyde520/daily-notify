# 环境变量配置示例
# 请复制此文件为 .env 并填入真实值，或者直接在 GitHub Secrets 中配置

# ==================== 通知方式配置 ====================
# 可选值：email, wechat, dingtalk, feishu
NOTIFICATION_TYPE=email

# ==================== 邮件配置 ====================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=recipient@example.com

# ==================== 企业微信配置 ====================
# 获取方式：企业微信管理后台 -> 应用管理 -> 创建应用 -> Webhook地址
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# ==================== 钉钉配置 ====================
# 获取方式：钉钉群设置 -> 机器人 -> 添加机器人 -> 自定义 -> Webhook地址
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
DINGTALK_SECRET=YOUR_SECRET

# ==================== 飞书配置 ====================
# 获取方式：飞书群设置 -> 机器人 -> 添加机器人 -> 自定义 -> Webhook地址
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_WEBHOOK

# ==================== 信息搜集配置 ====================
WEATHER_CITY=北京
NEWS_KEYWORD=
STOCK_SYMBOL=000001
